<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BlueClipboard" Width="800" Height="660" MinWidth="680" MinHeight="530" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" Foreground="#182434" ShowInTaskbar="True" Topmost="True" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#35465B"/><Setter Property="BorderBrush" Value="#DCE2EA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2EBF5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderThickness" Value="2"/><Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0078D4"/><Setter Property="Foreground" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#0063B1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#002C58"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#DCE2EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#0078D4"/></Style>
    <Style TargetType="RadioButton" x:Key="Filter"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bd" CornerRadius="3" Background="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DDECFA"/><Setter Property="Foreground" Value="#005A9E"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#B5D4F0"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="White" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="4"><Grid><Border x:Name="Rail" Width="3" Background="Transparent" HorizontalAlignment="Left"/><ContentPresenter Margin="14,12"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9AC4E8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF5FD"/><Setter TargetName="Card" Property="BorderBrush" Value="#8ABCE5"/><Setter TargetName="Rail" Property="Background" Value="#0078D4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#0078D4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border BorderBrush="#BAC7D5" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="White" BorderBrush="#E4E9EF" BorderThickness="0,0,0,1">
        <Grid Margin="22,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="42" Background="#0078D4" CornerRadius="4" Margin="0,0,13,0"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="BlueClipboard" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Всё, что вы скопировали. Под рукой." FontSize="11" Foreground="#6B7B8F" Margin="0,3,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#F0F4F8" CornerRadius="3" Padding="9,5" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock x:Name="HotkeyLabel" Text="Ctrl + Shift + V" FontSize="12" Foreground="#53667C"/></Border><Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" ToolTip="Настройки" AutomationProperties.Name="Настройки"/><Button x:Name="RestoreButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="Развернуть" AutomationProperties.Name="Развернуть"/><Button x:Name="CloseButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="Скрыть · Esc" AutomationProperties.Name="Скрыть"/></StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="22,18,22,12">
        <Grid><TextBox x:Name="SearchBox" Height="42" Padding="36,0,12,0" AutomationProperties.Name="Поиск по истории" ToolTip="Поиск по тексту и приложению · Ctrl+F"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#64758B" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="Найти в истории…" Foreground="#7E8B9B" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
        <DockPanel Margin="0,12,0,0"><Button x:Name="PauseButton" DockPanel.Dock="Right" Content="Ⅱ  Пауза" ToolTip="Приостановить запись буфера"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="AllFilter" GroupName="filter" Style="{StaticResource Filter}" Content="Всё" IsChecked="True"/><RadioButton x:Name="TextFilter" GroupName="filter" Style="{StaticResource Filter}" Content="Текст"/><RadioButton x:Name="ImageFilter" GroupName="filter" Style="{StaticResource Filter}" Content="Изображения"/><RadioButton x:Name="PinnedFilter" GroupName="filter" Style="{StaticResource Filter}" Content="Закреплённое"/></StackPanel></DockPanel>
      </StackPanel>
      <Grid Grid.Row="2" Margin="22,0,22,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" AutomationProperties.Name="История буфера">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding PinLabel}" DockPanel.Dock="Right" Foreground="#0078D4" FontSize="10"/><TextBlock Text="{Binding Badge}" Foreground="#64758B" FontSize="10" FontWeight="SemiBold"/></DockPanel><Image Source="{Binding Preview}" Stretch="Uniform" HorizontalAlignment="Left" MaxHeight="88" Margin="0,8,0,0"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="text"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Title}" FontSize="13" LineHeight="19" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,6,0,0"/><TextBlock Text="{Binding Meta}" Foreground="#7B8899" FontSize="10" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280" Margin="16"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#A5BDCF" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="История начинается с Ctrl+C" TextWrapping="Wrap" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock x:Name="EmptyBody" Text="Скопируйте текст или изображение. Оно появится здесь и останется после перезапуска." TextWrapping="Wrap" TextAlignment="Center" Foreground="#6B7B8F" LineHeight="20"/></StackPanel>
          <Button x:Name="MoreButton" Grid.Row="1" Content="Показать ещё" Visibility="Collapsed"/>
        </Grid>
        <Border Grid.Column="2" Background="White" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="4">
          <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PinButton" Padding="8" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" ToolTip="Закрепить" AutomationProperties.Name="Закрепить запись"/><Button x:Name="DeleteButton" Padding="8" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Удалить запись" AutomationProperties.Name="Удалить запись"/></StackPanel><TextBlock Text="ПРОСМОТР" FontSize="10" FontWeight="SemiBold" Foreground="#64758B" VerticalAlignment="Center"/></DockPanel>
            <TextBlock x:Name="DetailMeta" Grid.Row="1" Text="Выберите запись слева" Foreground="#7B8899" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" BorderThickness="0" Padding="0" Background="Transparent" FontSize="14" IsReadOnlyCaretVisible="True"/></ScrollViewer><Image x:Name="DetailImage" Stretch="Uniform" VerticalAlignment="Top" Visibility="Collapsed"/><TextBlock x:Name="DetailPlaceholder" Text="Текст целиком и изображения&#10;в исходном качестве." TextWrapping="Wrap" Foreground="#8A98A8" LineHeight="22" VerticalAlignment="Center" TextAlignment="Center"/></Grid>
            <TextBlock x:Name="TargetLabel" Grid.Row="3" Text="Откройте панель из нужного приложения" Foreground="#7B8899" FontSize="11" Margin="0,16,0,10" TextWrapping="Wrap"/>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PasteButton" Style="{StaticResource Primary}" Content="Вставить  ↵" Height="40"/><Button x:Name="CopyButton" Grid.Column="1" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="6,0,0,0" Padding="12,8" ToolTip="Копировать · Ctrl+Shift+C" AutomationProperties.Name="Копировать запись"/></Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Background="#EAF0F6" BorderBrush="#DCE4ED" BorderThickness="0,1,0,0"><DockPanel Margin="22,0"><TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Text="0 записей" Foreground="#718198" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="StatusLabel" Text="●  Буфер под наблюдением" Foreground="#44627D" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel></Border>
      <Border x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Background="#F3F5F8" Visibility="Collapsed" Padding="28,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><Button x:Name="BackButton" Content="←  Назад" DockPanel.Dock="Right"/><TextBlock Text="Как хранить вашу историю" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="История хранится только на этом компьютере." Foreground="#6B7B8F" Margin="0,8,0,22"/>
          <CheckBox x:Name="StartupSetting" Content="Запускать при входе в Windows" Margin="0,0,0,10"/>
          <CheckBox x:Name="WinVSetting" Content="Открывать BlueClipboard по Win+V вместо истории Windows" Margin="0,0,0,22"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Количество записей" Margin="0,0,0,8"/><ComboBox x:Name="LimitSetting" Height="34" SelectedIndex="1"><ComboBoxItem Content="5 000" Tag="5000"/><ComboBoxItem Content="20 000" Tag="20000"/><ComboBoxItem Content="50 000" Tag="50000"/><ComboBoxItem Content="Без ограничения" Tag="0"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Объём содержимого" Margin="0,0,0,8"/><ComboBox x:Name="SizeSetting" Height="34" SelectedIndex="1"><ComboBoxItem Content="512 МБ" Tag="512"/><ComboBoxItem Content="2 ГБ" Tag="2048"/><ComboBoxItem Content="10 ГБ" Tag="10240"/><ComboBoxItem Content="Без ограничения" Tag="0"/></ComboBox></StackPanel></Grid>
          <TextBlock Text="У записей нет срока давности. Когда лимит достигнут, удаляются самые старые. Закреплённое сохраняется даже сверх лимита. Размер базы на диске может быть больше объёма содержимого." TextWrapping="Wrap" Foreground="#6B7B8F" LineHeight="20" Margin="0,14,0,20"/>
          <StackPanel Margin="0,0,0,18"><TextBlock x:Name="VersionLabel" FontWeight="SemiBold"/><CheckBox x:Name="AutoUpdate" Content="Устанавливать обновления автоматически" Margin="0,8"/><Button x:Name="UpdateButton" Content="Проверить обновления" HorizontalAlignment="Left" BorderThickness="1"/><TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
          <Button x:Name="SaveSettingsButton" Content="Сохранить настройки" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="20,10"/>
          <Border BorderBrush="#DCE2EA" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="Управление историей" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Буфер может содержать личные данные и пароли. База не зашифрована. При необходимости включайте паузу; приложения могут запрещать сохранение своих записей." Foreground="#6B7B8F" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="ClearButton" Content="Очистить незакреплённое" BorderThickness="1"/><Button x:Name="FolderButton" Content="Открыть папку истории" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Window>
